[user]
    name = jeff
    email = 46485515+jeff.tooke@users.noreply.github.com
[includeIf "gitdir:~/projects/work/"]
    path = ~/projects/.gitconfig-work
{{/* work-Mac credential helper disabled for now — re-enable with is_work_mac (see Follow-up)
{{- if and (eq .chezmoi.os "darwin") .is_work_mac }}
[credential]
    helper = osxkeychain
{{- end }}
*/}}
[url "https://github.com/"]
    insteadOf = https://gh/
[color]
    diff = auto
    status = auto
    branch = auto
    ui = true
[commit]
    gpgsign = false
[core]
    excludesfile = ~/.gitignore
    editor = nvim
[apply]
    whitespace = nowarn
[mergetool]
    keepBackup = false
[difftool]
    prompt = false
[help]
    autocorrect = 1
[push]
    default = simple
[pull]
    rebase = false
[init]
    defaultBranch = main
[gpg]
    program = /usr/local/bin/gpg
[secrets]
    providers = git secrets --aws-provider
    patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
    patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
    patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
    allowed = AKIAIOSFODNN7EXAMPLE
    allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
