# ---- Starship prompt ----
eval "$(starship init zsh)"

# ---- Enable zsh completions early ----
zmodload zsh/complist
autoload -Uz compinit
compinit -i

# ---- Auto-launch tmux silently if not already inside ----
if [[ -z "$TMUX" && -z "$NVIM" ]]; then
  exec tmux new-session -A -s main >/dev/null 2>&1
fi

# ---- Only run the rest of shell config inside tmux ----
if [ -n "$TMUX" ]; then
  # ---- Basic exports and setup ----
  export VISUAL=nvim
  export EDITOR=nvim
  export HOMEBREW_NO_ENV_HINTS=1
  eval "$(direnv hook zsh)"

# ---- Update $PATH with useful locations ----
  export PATH="$PATH:/usr/sbin:/sbin"

# ---- Source plugins and theme ----
  source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

  # Load modular Zsh files if they exist
  ZSH_CONFIG_DIR="$HOME/.config/zsh"
  [[ -f "$ZSH_CONFIG_DIR/aliases.zsh" ]] && source "$ZSH_CONFIG_DIR/aliases.zsh"
  [[ -f "$ZSH_CONFIG_DIR/env-specific-aliases.zsh" ]] && source "$ZSH_CONFIG_DIR/env-specific-aliases.zsh"
  [[ -f "$ZSH_CONFIG_DIR/git.zsh" ]] && source "$ZSH_CONFIG_DIR/git.zsh"
  [[ -f "$ZSH_CONFIG_DIR/history.zsh" ]] && source "$ZSH_CONFIG_DIR/history.zsh"

  # ---- FZF ----
  eval "$(fzf --zsh)"
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_DEFAULT_OPTS="--bind 'enter:execute($EDITOR {} > /dev/tty)'"

  ff() {
    local search_term="$1"
    local search_dir="${2:-.}"
    fd "$search_term" --type f "$search_dir" | fzf --preview 'bat --style=numbers --color=always {} | less -R' --preview-window=right:50%
  }

  # ---- Go Workspace ----
  export GOPATH="$HOME/go"
  export GOBIN="$GOPATH/bin"
  export PATH="$PATH:$GOBIN"

  # ---- Zoxide ----
  eval "$(zoxide init zsh --cmd cd)"

  # ---- Brew completions (already safe because compinit ran earlier) ----
  if type brew &>/dev/null; then
    FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
  fi
fi
