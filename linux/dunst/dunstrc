[global]
    monitor = 0
    follow = mouse
    width = 320
    height = 150
    origin = top-right
    offset = 12x48
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#313244"
    corner_radius = 8
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
