# Exclude repo-only docs (kept in the repo, not applied to $HOME)
README.md
TODO.md

# Exclude anything backup related
**/*backup*

# Exclude log files
**/*.log

# Exclude encryption keys and config
.sops.yaml
.config/sops/age/keys.txt

# Never manage Claude/OpenCode runtime config — may hold tokens / private URLs.
# File-specific on purpose: must NOT match .claude/agents/** or .config/opencode/agent/**.
.claude/settings.json
.claude/settings.local.json
.claude/.credentials.json
.claude/history.jsonl
.claude/.superclaude-metadata.json
.claude/mcp-needs-auth-cache.json
.config/opencode/opencode.json

# Editor/OS cruft, always ignored
*~
*.swp
.DS_Store
.config/nvim/lazy-lock.json

# macOS-only tools: ignore UNLESS we're on darwin.
{{ if ne .chezmoi.os "darwin" }}
.config/aerospace/**
.config/borders/**
.config/direnv/**
.config/ghostty/**
.config/karabiner/**
.config/sketchybar/**
.hammerspoon/**
{{ end }}

# Linux-only tools: ignore IF we're on darwin.
{{ if eq .chezmoi.os "darwin" }}
.config/dunst/**
.config/foot/**
.config/hypr/**
.config/waybar/**
.config/wofi/**
.local/bin/kitty-gl
.local/share/applications/kitty.desktop
{{ end }}
